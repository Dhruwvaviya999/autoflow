<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background, built as three stacked full-bleed layers:

    1. base     - diagonal sweep through the AutoFlow accent blues
    2. bloom    - off-centre electric glow sitting behind the bolt
    3. vignette - corner falloff that pushes focus back to the centre

  All three cover the whole 108x108 canvas because the launcher crops to the
  device mask at draw time. The bloom is deliberately in the *background*
  rather than the foreground: the foreground drawable doubles as the
  notification small icon, where Android keeps only the alpha channel, so a
  translucent glow there would render as a grey box around the bolt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="0"
                android:endX="102"
                android:endY="108">
                <item android:color="#FF9CC0FF" android:offset="0.0" />
                <item android:color="#FF5578F5" android:offset="0.38" />
                <item android:color="#FF2138B8" android:offset="0.72" />
                <item android:color="#FF0B1450" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="45"
                android:centerY="40"
                android:gradientRadius="56">
                <item android:color="#9EE4FBFF" android:offset="0.0" />
                <item android:color="#3AC2E8FF" android:offset="0.42" />
                <item android:color="#00A5D2FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="80">
                <item android:color="#00000818" android:offset="0.32" />
                <item android:color="#38000818" android:offset="0.70" />
                <item android:color="#82000818" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
