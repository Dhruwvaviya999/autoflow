<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a single lightning bolt.

  Geometry is the classic six-vertex bolt, scaled 2.9x and centred on
  (54,54): 40.6 wide by 58 tall. The furthest vertex sits 29.6 units from
  centre, inside the 33-unit safe radius every adaptive mask must preserve,
  so no launcher shape (circle, squircle, teardrop) can clip it.

  Fill is a top-to-bottom ramp from pure white into a cool blue-white. That
  reads as light falling off down the bolt and stops the shape looking like
  flat vinyl, while staying fully opaque so the same drawable still works as
  a notification small icon, where only alpha survives.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M59.8,25 L33.7,59.8 L51.1,59.8 L48.2,83 L74.3,48.2 L56.9,48.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="83">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFF4F8FF" android:offset="0.45" />
                <item android:color="#FFD3E1FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
