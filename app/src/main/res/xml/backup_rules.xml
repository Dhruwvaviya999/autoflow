<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup is disabled in the manifest (android:allowBackup="false").
    These rules exist as defense in depth: if backup is ever enabled, the
    automation database, its journals and AutoFlow's preferences must still be
    excluded, because they can contain automation definitions and — when the
    user adds the Save notification action — notification content.

    Used on API 30 and below; API 31+ uses data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
